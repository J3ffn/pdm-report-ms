# =============================================================================
# pdm-report-ms — Template de Variáveis de Ambiente
#
# ✅ Este arquivo É commitado no git — serve como documentação das variáveis
#    necessárias para rodar o projeto.
#
# Como usar:
#   cp .env.example .env
#   # Preencha os valores reais no .env (nunca commite o .env)
#
# Gerando a chave AES para CPF (desenvolvimento):
#   openssl rand -base64 32
# =============================================================================

# --- Servidor ---
SPRING_PROFILES_ACTIVE=dev

# --- PostgreSQL ---
DATA_POSTGRES_URL=jdbc:postgresql://localhost:5432/pdm_db
DATA_POSTGRES_USERNAME=pdm_user
DATA_POSTGRES_PASSWORD=pdm_password

# --- Keycloak / JWT ---
JWT_ISSUER_URI=http://localhost:8080/realms/pdm-realm
JWT_JWK_URI=http://localhost:8080/realms/pdm-realm/protocol/openid-connect/certs

# --- RabbitMQ ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# --- Criptografia CPF (AES-256-GCM) ---
# Gere com: openssl rand -base64 32
# ATENÇÃO: Este valor de exemplo (32 bytes) é APENAS para desenvolvimento local.
# Em produção, use o Secret Manager GCP — nunca commite a chave real.
CPF_AES_KEY=MTIzNDU2Nzg5MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTI=

# --- Observabilidade ---
# URL do Loki para envio de logs estruturados
LOKI_URL=http://localhost:3100

# --- CORS (quando usando sem Gateway) ---
# CORS_ALLOWED_ORIGINS=http://localhost:5173
