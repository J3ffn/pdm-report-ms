# =============================================================================
# pdm-report-ms — Template de Variáveis de Ambiente
#
# ✅ Este arquivo É commitado no git — serve como documentação das variáveis
#    necessárias para rodar o projeto.
#
# Como usar:
#   cp .env.example .env
#   # Preencha os valores reais no .env (nunca commite o .env)
# =============================================================================

# --- Servidor ---
SPRING_PROFILES_ACTIVE=

# --- PostgreSQL ---
DATA_POSTGRES_URL=
DATA_POSTGRES_USERNAME=
DATA_POSTGRES_PASSWORD=

# --- Keycloak / JWT ---
JWT_ISSUER_URI=
JWT_JWK_URI=

# --- RabbitMQ ---
RABBITMQ_HOST=
RABBITMQ_PORT=
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
